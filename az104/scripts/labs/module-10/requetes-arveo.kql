// Q1 — État des pulsations de l'agent Azure Monitor (requête complète)
Heartbeat
| where TimeGenerated > ago(1h)
| summarize Dernier = max(TimeGenerated) by Computer
| extend Minutes = datetime_diff('minute', now(), Dernier)
| extend Etat = iff(Minutes > 5, "SILENCIEUX", "OK")
| order by Minutes desc

// Q2 — CPU moyen et maximal par minute des serveurs web, dernière heure
Perf
| where TimeGenerated > ago(1h)
| where ObjectName == "Processor" and CounterName == "% Processor Time"
// TODO : ne garder que l'instance totale du processeur
// TODO : moyenne (CpuMoyen) et maximum (CpuMax) par serveur et par minute
// TODO (portail) : tracer une courbe

